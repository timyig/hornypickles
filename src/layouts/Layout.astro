---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Horny Pickles. Something good is on the way.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#183c2e" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a class="wordmark" href={base} aria-label="Horny Pickles home">
        <span class="mark" aria-hidden="true">hp.</span>
        <span>Horny Pickles</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>Horny Pickles &copy; {new Date().getFullYear()}</footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: Arial, Helvetica, sans-serif;
    color: #183c2e;
    background: #f5f2e8;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100svh; display: flex; flex-direction: column; }
  header, main, footer { width: min(100% - 3rem, 72rem); margin-inline: auto; }
  header { padding-block: 2rem; }
  main { flex: 1; display: grid; align-content: center; padding-block: 4rem 6rem; }
  footer { padding-block: 1.5rem; border-top: 1px solid #183c2e33; font-size: 0.875rem; }
  a { color: inherit; }
  a:focus-visible { outline: 3px solid #647c12; outline-offset: 6px; }
  .wordmark { display: inline-flex; align-items: center; gap: 0.75rem; font-weight: 700; text-decoration: none; }
  .mark { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; background: #183c2e; color: #d7ed99; font-size: 1.25rem; }
  .eyebrow { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  h1 { max-width: 12ch; margin: 1rem 0 1.5rem; font-size: clamp(3.25rem, 10vw, 8rem); line-height: 0.95; letter-spacing: -0.065em; }
  .intro { max-width: 36rem; margin: 0; font-size: clamp(1.125rem, 2.5vw, 1.5rem); line-height: 1.6; }
  .skip-link { position: absolute; top: 0.5rem; left: 0.5rem; padding: 0.75rem; background: #f5f2e8; transform: translateY(-200%); }
  .skip-link:focus { transform: translateY(0); }
</style>
