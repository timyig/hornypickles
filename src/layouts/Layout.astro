---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Picky by choice. Außergewöhnliche Pickles, geniale Essigmischungen und jede Menge Geschmack – entdecke Picky Pickles.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#790943" />
    <link rel="icon" type="image/png" href={`${base}assets/picky-onion.png`} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
