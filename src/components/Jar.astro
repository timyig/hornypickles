---
interface Props {
  product: 'onion' | 'carrot' | 'tomato' | 'radish';
  decorative?: boolean;
  eager?: boolean;
}
const { product, decorative = false, eager = false } = Astro.props;
const jars = {
  onion: { ratio: 262.723 / 408, inset: '-31.91% -76.59% -28.4% -72.37%', name: 'Picky Onion – Rote Zwiebel' },
  carrot: { ratio: 271.57 / 408, inset: '-23.92% -57.32% -18.94% -57.32%', name: 'Picky Carrot – Karotte' },
  tomato: { ratio: 261.763 / 408, inset: '-31.88% -76.79% -28.01% -72.41%', name: 'Picky Tomato – Eingelegte Cherrytomaten' },
  radish: { ratio: 265.413 / 408, inset: '-15.31% -49.36% -13.97% -49.36%', name: 'Picky Radish – Radieschen' },
};
const jar = jars[product];
---
<div class="jar" data-product={product} style={`--jar-ratio: ${jar.ratio}; --image-inset: ${jar.inset}`}>
  <div class="jar-image">
    <img src={`${import.meta.env.BASE_URL}assets/picky-${product}.png`} alt={decorative ? '' : jar.name} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
</div>
<style>
  /* Normalize transparent margins, preserving the original PNG bytes and label proportions. */
  .jar { position: relative; flex: none; height: var(--jar-height); width: calc(var(--jar-height) * var(--jar-ratio)); overflow: clip; }
  .jar-image { position: absolute; inset: var(--image-inset); }
  img { display: block; width: 100%; height: 100%; object-fit: contain; max-width: none; }
</style>
