---
import Layout from '../layouts/Layout.astro';
import Jar from '../components/Jar.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero-table.jpg';
import mealPhoto from '../assets/meal.jpg';
const base = import.meta.env.BASE_URL;
const benefits = [
  { icon: 'timer', label: 'Schnell & Unkompliziert' },
  { icon: 'chef-hat', label: 'Restaurant-Feeling für zu Hause' },
  { icon: 'soup', label: 'Mehr Abwechslung im Alltag' },
];
const products = ['onion', 'carrot', 'tomato', 'radish'] as const;
---
<Layout title="Picky Pickles · Picky by choice.">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-claim"><h1 id="hero-heading">PICKY BY<span class="mobile-break"><br /></span><span class="desktop-space"> </span>CHOICE.</h1></div>
    <div class="hero-composition">
      <Image class="hero-photo" src={heroPhoto} format="webp" quality={88} widths={[480, 768, 1200, 1680, 2100]} sizes="(max-width: 767px) 100vw, 70vw" alt="Gemeinsam genießen: ein Tisch voller guter Gerichte." fetchpriority="high" />
      <div class="hero-jar"><Jar product="onion" eager /></div>
      <a class="hero-cta" href="#newsletter"><img src={`${base}assets/organic-button.svg`} alt="" aria-hidden="true" /><span>JETZT ZUM<br />NEWSLETTER<br />ANMELDEN</span></a>
    </div>
  </section>

  <section class="about" id="ueber-uns" aria-labelledby="about-heading">
    <p class="eyebrow">UNSERE HALTUNG</p>
    <div class="about-columns">
      <h2 id="about-heading">EINGELEGT.<br />NICHT<br />EINGEFAHREN.</h2>
      <div class="about-story">
        <h3>WOW, ganz schön picky!</h3>
        <p>Richtig so, wählerisch sind wir nämlich auch! Deshalb denken wir Pickles weiter: mit unserer genialen Essigmischung, außergewöhnlichen Gemüsesorten und Rezepturen, die überraschen.</p>
        <p>Denn wenn’s um guten Geschmack geht, machen wir keine Kompromisse.</p>
        <p class="signature">Picky by choice.</p>
      </div>
    </div>
  </section>

  <section class="meal" id="inspiration" aria-labelledby="meal-heading">
    <div class="meal-photo"><Image src={mealPhoto} format="webp" quality={88} widths={[480, 768, 1200, 1680]} sizes="(max-width: 1023px) 100vw, 48vw" alt="Bunter Teller mit eingelegten roten Zwiebeln, Kräutern und cremigem Dressing." loading="lazy" decoding="async" /></div>
    <div class="meal-copy">
      <h2 id="meal-heading">PIMP YOUR MEAL.</h2>
      <h3>Wenig Aufwand. Ganz viel Geschmack.</h3>
      <p>Ob aufs Brot, in die Bowl oder zum Feierabendessen:<br />Mit unseren Pickles machst du aus einfachen Gerichten im Glasaufdrehen etwas Besonderes. Ganz ohne großen Aufwand, aber mit jeder Menge Geschmack.</p>
      <ul class="benefits" aria-label="Deine Vorteile">
        {benefits.map(({ icon, label }) => <li><img src={`${base}assets/${icon}.svg`} width="44" height="44" alt="" aria-hidden="true" loading="lazy" /><span>{label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="products" id="produkte" aria-labelledby="products-heading">
    <div class="products-intro">
      <p class="eyebrow">DEIN NÄCHSTER LIEBLING IM GLAS</p>
      <h2 id="products-heading">UNSERE PICKLES.</h2>
      <p>Vier Charaktere. Alles außer gewöhnlich.</p>
    </div>
    <ul class="product-jars" aria-label="Unsere vier Pickles">
      {products.map(product => <li><Jar product={product} /></li>)}
    </ul>
  </section>

  <section class="newsletter" id="newsletter" aria-labelledby="newsletter-heading">
    <div class="newsletter-intro">
      <p class="eyebrow">GUTER GESCHMACK. GUTE POST.</p>
      <h2 id="newsletter-heading">BLEIB PICKY!</h2>
      <p>Erfahre als Erstes, wann und wo du unsere Pickles kaufen kannst und was es bei uns Neues gibt!</p>
    </div>
    <div class="newsletter-preview" role="group" aria-labelledby="form-title" aria-describedby="preview-note">
      <p id="form-title">Jetzt zum Newsletter anmelden!</p>
      <fieldset disabled>
        <legend class="sr-only">Newsletter-Formularvorschau – Anmeldung noch nicht verfügbar</legend>
        <label class="sr-only" for="newsletter-name">Vorname</label>
        <input id="newsletter-name" type="text" placeholder="VORNAME" autocomplete="given-name" />
        <label class="sr-only" for="newsletter-email">E-Mail-Adresse</label>
        <input id="newsletter-email" type="email" placeholder="EMAIL" autocomplete="email" />
        <label class="consent"><input type="checkbox" /><span>Ich stimme zu, deine E-Mails zu erhalten, und bestätige, dass ich deine Datenschutzerklärung und deinen rechtlichen Hinweis gelesen habe.*</span></label>
        <button class="pill" type="button">JETZT ANMELDEN</button>
      </fieldset>
    </div>
    <p class="preview-note" id="preview-note">Formularvorschau<span class="sr-only"> – die Newsletter-Anmeldung ist noch nicht verfügbar.</span></p>
  </section>
</Layout>

<style>
  .hero-claim { padding: 24px var(--gutter); color: var(--cream); background: var(--ink); text-align: center; }
  h1 { font-size: clamp(86px, 8.3333vw, 120px); line-height: 1.083333; }
  .mobile-break { display: none; }
  .hero-composition { height: 520px; position: relative; overflow: clip; background: var(--pink); }
  .hero-photo { position: absolute; left: 0; top: 0; width: 70%; height: 100%; object-fit: cover; object-position: center; clip-path: polygon(0 0, 100% 0, 82.86% 100%, 0 100%); }
  .hero-jar { position: absolute; --jar-height: 448px; top: 36px; right: 5.5%; }
  .hero-cta { position: absolute; display: flex; align-items: center; justify-content: center; width: 270px; height: 160px; left: min(calc(61% - 135px), calc(94.5% - 582.48px)); top: 180px; text-align: center; font-size: 28px; font-weight: 900; line-height: 30px; isolation: isolate; }
  .hero-cta img { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .about { padding: 40px var(--gutter); }
  .about > .eyebrow { margin-bottom: 16px; }
  .about-columns { display: grid; grid-template-columns: 44% 1fr; align-items: center; gap: 44px; }
  .about h2 { font-size: 80px; line-height: 86px; }
  .about-story { display: flex; flex-direction: column; gap: 14px; border-left: 1px solid var(--ink); padding-left: 44px; }
  .about-story h3 { font-size: 32px; line-height: 42px; }
  .about-story p { font-size: 20px; line-height: 26px; }
  .about-story .signature { font-size: 28px; line-height: 36px; font-weight: 700; }
  .meal { display: grid; grid-template-columns: 48% 52%; background: var(--ink); color: var(--cream); }
  .meal-photo { position: relative; min-height: 438px; overflow: hidden; }
  .meal-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 88%; }
  .meal-copy { padding: 40px 48px; display: flex; flex-direction: column; gap: 20px; }
  .meal h2 { font-size: 60px; line-height: 65px; }
  .meal h3 { font-size: 24px; line-height: 31px; }
  .meal-copy > p { font-size: 20px; line-height: 26px; }
  .benefits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .benefits li { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 0 16px; text-align: center; font-size: 18px; line-height: 23px; font-weight: 700; }
  .benefits li:first-child { padding-left: 0; } .benefits li:last-child { padding-right: 0; }
  .benefits li + li { border-left: 1px solid var(--cream); }
  .benefits img { width: 44px; height: 44px; }
  .products { padding: 48px var(--gutter); }
  .products-intro, .newsletter-intro { display: flex; flex-direction: column; gap: 12px; }
  .products h2 { font-size: 80px; line-height: 86px; }
  .products-intro > p:last-child { font-size: 20px; line-height: 26px; }
  .product-jars { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: end; gap: 24px; margin: 28px 0 0; padding: 0; list-style: none; --jar-height: min(408px, calc((100vw - 2 * var(--gutter) - 88px) / 4 / .66561)); }
  .product-jars li { display: flex; justify-content: center; min-width: 0; }
  .newsletter { padding: 44px var(--gutter); background: var(--yellow); display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .newsletter-intro { max-width: 680px; text-align: center; }
  .newsletter h2 { font-size: 80px; line-height: 86px; }
  .newsletter-intro > p:last-child { font-size: 20px; line-height: 26px; }
  .newsletter-preview { width: 100%; max-width: 540px; padding: 28px 32px 56px; background: var(--form); color: white; }
  .newsletter-preview > p { font-size: 16px; line-height: 21px; margin-bottom: 16px; }
  fieldset { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 0; margin: 0; border: 0; min-width: 0; }
  input:not([type='checkbox']) { width: 100%; height: 40px; border: 1px solid #c7c7c7; border-radius: 3px; background: white; padding: 0 16px; font-size: 14px; line-height: 20px; }
  input::placeholder { color: #abbccd; opacity: 1; }
  input:disabled, button:disabled { opacity: 1; -webkit-text-fill-color: currentColor; cursor: not-allowed; }
  .consent { display: flex; align-items: flex-start; gap: 10px; font-size: 12px; line-height: 20px; }
  .consent input { appearance: none; flex: none; width: 15px; height: 15px; background: #b980b7; border: 0; border-radius: 2px; margin: 0; }
  .preview-note { font-size: 12px; line-height: 16px; text-align: center; }
  @media (min-width: 1024px) and (max-width: 1199px) {
    .hero-composition { height: 440px; }
    .hero-jar { --jar-height: 376px; top: 32px; right: 4%; }
    .hero-cta { left: calc(56.5% - 135px); top: 140px; }
    .about h2 { font-size: 60px; line-height: 65px; }
    .about-columns { gap: 28px; } .about-story { padding-left: 28px; }
    .meal h2 { font-size: 45px; line-height: 49px; }
    .meal-copy { padding-inline: 32px; }
    .benefits li { font-size: 16px; line-height: 21px; padding-inline: 12px; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    h1 { font-size: 82px; line-height: 89px; }
    .hero-composition { height: 420px; }
    .hero-jar { --jar-height: 330px; top: 45px; right: 20px; }
    .hero-cta { width: 210px; height: 124px; font-size: 22px; line-height: 24px; left: min(calc(57.76% - 105px), calc(100% - 457.5px)); top: 148px; }
    .about h2 { font-size: 48px; line-height: 52px; }
    .about-columns { gap: 28px; } .about-story { padding-left: 28px; }
    .about-story h3 { font-size: 26px; line-height: 34px; }
    .about-story p { font-size: 18px; line-height: 23px; }
    .meal { grid-template-columns: 1fr; } .meal-photo { min-height: 0; height: 480px; }
    .meal-copy { padding: 40px; }
    .products h2 { font-size: 64px; line-height: 69px; }
    .newsletter h2 { font-size: 72px; line-height: 78px; }
  }
  @media (max-width: 767px) {
    .hero-claim { padding: 20px var(--gutter); }
    h1 { font-size: 54px; line-height: 58px; }
    .mobile-break { display: inline; } .desktop-space { display: none; }
    .hero-composition { height: 660px; }
    .hero-photo { width: 100%; height: 302px; clip-path: polygon(0 0, 100% 0, 100% 78.15%, 0 100%); }
    .hero-jar { --jar-height: 282px; top: 364px; right: auto; left: 50%; transform: translateX(-50%); }
    .hero-cta { width: 210px; height: 124px; top: 216px; left: 50%; transform: translateX(-50%); font-size: 22px; line-height: 24px; }
    .about { padding-block: 32px; }
    .about-columns { grid-template-columns: 1fr; gap: 22px; }
    .about h2 { font-size: 49px; line-height: 53px; }
    .about-story { border: 0; padding: 0; gap: 12px; }
    .about-story h3 { font-size: 26px; line-height: 34px; }
    .about-story p { font-size: 17px; line-height: 22px; }
    .about-story .signature { font-size: 24px; line-height: 31px; }
    .meal { grid-template-columns: 1fr; }
    .meal-photo { min-height: 0; height: 320px; }
    .meal-copy { padding: 32px var(--gutter); gap: 18px; }
    .meal h2 { font-size: 43px; line-height: 46px; }
    .meal h3 { font-size: 21px; line-height: 27px; }
    .meal-copy > p { font-size: 17px; line-height: 22px; }
    .benefits { grid-template-columns: 1fr; gap: 18px; }
    .benefits li, .benefits li:first-child, .benefits li:last-child { border: 0; padding: 0; font-size: 16px; line-height: 21px; }
    .benefits li + li { border-left: 0; }
    .benefits img { width: 32px; height: 32px; }
    .products { padding-block: 36px; }
    .products h2 { font-size: 46px; line-height: 50px; }
    .products-intro > p:last-child { font-size: 18px; line-height: 23px; }
    .product-jars { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 20px; --jar-height: 220px; }
    .newsletter { padding-block: 36px; }
    .newsletter h2 { font-size: 58px; line-height: 63px; }
    .newsletter-intro > p:last-child { font-size: 18px; line-height: 23px; }
    .newsletter-preview { padding-inline: 24px; }
  }
  @media (max-width: 374px) { .about h2 { font-size: 44px; } .meal h2 { font-size: 38px; } .products h2 { font-size: 42px; } .product-jars { --jar-height: 195px; } }
</style>
